# Shaadi Wala public client configuration.
# Copy this file to .env for local web and Android builds.
#
# The anon key is meant to ship inside the app. Row-level security makes each
# wedding visible only to its members. Never put the service role key here,
# in Vercel, or in the Android project.

# Hosted project ref: ujglzkfxgewqupkeqyek
# Region: ap-south-1 (Mumbai), Free plan
# Dashboard: https://supabase.com/dashboard/project/ujglzkfxgewqupkeqyek
VITE_SUPABASE_URL=https://ujglzkfxgewqupkeqyek.supabase.co

# Project Settings → API keys. Either value works. The publishable key below is public.
# Leave the anon key blank to use the publishable key. Do not commit a filled-in .env.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HVHOVn_lC-5EBEBSFBhLkA_gQgrWLm4

# Optional override for auth redirects.
# Web builds default to the current origin + /auth.
# Android builds default to in.shaadiwala.app://auth/callback (the app id in app.config.json).
VITE_AUTH_REDIRECT_URL=

# Optional. Leave blank to disable analytics. The app sends nothing when the key is empty.
# VITE_POSTHOG_HOST defaults to https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
